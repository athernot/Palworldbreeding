{
  "name": "palworld-owned-pal-extractor",
  "private": true,
  "version": "1.0.0",
  "description": "Palworld Owned Pal Extractor",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
